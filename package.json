{
  "name": "kairos",
  "version": "1.0.0",
  "private": true,
  "description": "Kairos — a proactive personal agent OS. Your day, run by someone who never forgets.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "pnpm build:web && pnpm build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node --no-warnings=ExperimentalWarning dist/server/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "docker:build": "docker build -t kairos .",
    "docker:run": "docker run --rm -p 8787:8787 -v kairos-data:/data -e KAIROS_DB=/data/kairos.db -e HOST=0.0.0.0 kairos",
    "e2e": "node tests/e2e/smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.19.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "playwright": "^1.62.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
